    "paths": {"/books": {
      "parameters": [{"in": "query", "name": "limit", "schema": {"type": "integer"}}],
      "get": {"responses": {"200": {"description": "List"}}},
      "head": {
        "parameters": [{"in": "query", "name": "limit", "schema": {"type": "number"}}],
        "responses": {"200": {"description": "Available"}}
      }
    }}
  },
  "after": {
    "openapi": "3.1.0", "info": {"title": "Catalog", "version": "1"},
    "paths": {"/books": {
      "get": {"responses": {"200": {"description": "List"}}},
      "head": {
        "parameters": [{"in": "query", "name": "limit", "schema": {"type": "number"}}],
        "responses": {"200": {"description": "Available"}}
      }
    }}
  },
  "expected": [{
