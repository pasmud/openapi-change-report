{
  "title": "Adding a request body with required true breaks existing callers",
  "before": {
    "openapi": "3.1.0", "info": {"title": "Stamps", "version": "1"},
    "paths": {"/stamps": {"post": {"responses": {"204": {"description": "Saved"}}}}}
  },
  "after": {
    "openapi": "3.1.0", "info": {"title": "Stamps", "version": "1"},
    "paths": {"/stamps": {"post": {
      "requestBody": {"required": true, "content": {"text/plain": {"schema": {"type": "string"}}}},
      "responses": {"204": {"description": "Saved"}}
    }}}
  },
  "expected": [{
    "severity": "breaking", "code": "body.required",
    "before": null, "after": "/paths/~1stamps/post/requestBody/required", "operation": "/paths/~1stamps/post"
  }]
}
