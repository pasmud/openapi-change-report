    "paths": {"/scores": {"get": {"responses": {"200": {
      "description": "Rows", "content": {"application/json": {"schema": {
        "type": "array", "items": {"type": "array", "items": {"type": "integer"}}
      }}}
    }}}}}
  },
  "after": {
    "openapi": "3.1.0", "info": {"title": "Scores", "version": "1"},
    "paths": {"/scores": {"get": {"responses": {"200": {
      "description": "Rows", "content": {"application/json": {"schema": {
