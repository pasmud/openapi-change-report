{
  "title": "Requiring an existing body points to the old body when defaulted",
  "before": {
    "openapi": "3.1.0", "info": {"title": "Stamps", "version": "1"},
    "paths": {"/stamps": {"post": {
      "requestBody": {"content": {"text/plain": {"schema": {"type": "string"}}}},
      "responses": {"204": {"description": "Saved"}}
    }}}
  },
  "after": {
    "openapi": "3.1.0", "info": {"title": "Stamps", "version": "1"},
    "paths": {"/stamps": {"post": {
      "requestBody": {"required": true, "content": {"text/plain": {"schema": {"type": "string"}}}},
      "responses": {"204": {"description": "Saved"}}
    }}}
  },
  "expected": [{
    "severity": "breaking", "code": "body.required", "operation": "/paths/~1stamps/post",
    "before": "/paths/~1stamps/post/requestBody", "after": "/paths/~1stamps/post/requestBody/required"
  }]
}
