  },
  "after": {
    "openapi": "3.0.4", "info": {"title": "Stamps", "version": "1"},
    "paths": {"/stamps": {"post": {
      "requestBody": {"required": false, "content": {"text/plain": {"schema": {"type": "string"}}}},
