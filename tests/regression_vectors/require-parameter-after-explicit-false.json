{
  "title": "An explicit false parameter requirement has its own pointer",
  "before": {
    "openapi": "3.1.0", "info": {"title": "Catalog", "version": "1"},
    "paths": {"/books": {"get": {
      "parameters": [{"in": "query", "name": "locale", "required": false, "schema": {"type": "string"}}],
      "responses": {"200": {"description": "List"}}
    }}}
  },
  "after": {
    "openapi": "3.1.0", "info": {"title": "Catalog", "version": "1"},
    "paths": {"/books": {"get": {
      "parameters": [{"in": "query", "name": "locale", "required": true, "schema": {"type": "string"}}],
      "responses": {"200": {"description": "List"}}
    }}}
  },
  "expected": [{
    "severity": "breaking", "code": "parameter.required", "operation": "/paths/~1books/get",
    "before": "/paths/~1books/get/parameters/0/required", "after": "/paths/~1books/get/parameters/0/required"
  }]
}
