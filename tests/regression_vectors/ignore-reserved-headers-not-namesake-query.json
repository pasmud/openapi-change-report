{
  "title": "Reserved headers are ignored case-insensitively but queries are not",
  "before": {
    "openapi": "3.1.0", "info": {"title": "Catalog", "version": "1"},
    "paths": {"/books": {"get": {"responses": {"200": {"description": "List"}}}}}
  },
  "after": {
    "openapi": "3.1.0", "info": {"title": "Catalog", "version": "1"},
    "paths": {"/books": {"get": {
      "parameters": [
        {"in": "header", "name": "aCcEpT", "required": true, "schema": {"type": "string"}},
        {"in": "header", "name": "CONTENT-TYPE", "required": true, "schema": {"type": "string"}},
        {"in": "header", "name": "Authorization", "required": true, "schema": {"type": "string"}},
        {"in": "query", "name": "aCcEpT", "schema": {"type": "string"}}
      ],
      "responses": {"200": {"description": "List"}}
    }}}
  },
  "expected": [{
    "severity": "non-breaking", "code": "parameter.added",
    "before": null, "after": "/paths/~1books/get/parameters/3", "operation": "/paths/~1books/get"
  }]
}
