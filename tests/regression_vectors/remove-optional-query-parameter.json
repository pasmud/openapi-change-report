{
  "title": "Removing an optional query parameter needs review",
  "before": {
    "openapi": "3.1.0", "info": {"title": "Catalog", "version": "1"},
    "paths": {"/books": {"get": {
      "parameters": [{"in": "query", "name": "limit", "schema": {"type": "integer"}}],
      "responses": {"200": {"description": "List"}}
    }}}
  },
  "after": {
    "openapi": "3.1.0", "info": {"title": "Catalog", "version": "1"},
    "paths": {"/books": {"get": {"responses": {"200": {"description": "List"}}}}}
  },
  "expected": [{
    "severity": "review", "code": "parameter.removed",
    "before": "/paths/~1books/get/parameters/0", "after": null, "operation": "/paths/~1books/get"
  }]
}
