{
  "title": "A stable operationId does not match endpoints across paths",
  "before": {
    "openapi": "3.1.0", "info": {"title": "Tiles", "version": "1"},
    "paths": {"/tiles": {"get": {"operationId": "listTiles", "responses": {"200": {"description": "List"}}}}}
  },
  "after": {
    "openapi": "3.1.0", "info": {"title": "Tiles", "version": "1"},
    "paths": {"/catalog": {"get": {"operationId": "listTiles", "responses": {"200": {"description": "List"}}}}}
  },
  "expected": [
    {"severity": "breaking", "code": "operation.removed", "before": "/paths/~1tiles/get", "after": null, "operation": "/paths/~1tiles/get"},
    {"severity": "non-breaking", "code": "operation.added", "before": null, "after": "/paths/~1catalog/get", "operation": "/paths/~1catalog/get"}
  ]
}
